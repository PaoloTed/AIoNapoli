# ==============================================================================
# Environment Configuration for Postgres 18 + PostGIS + GTFS / OSM Ingestion
# ==============================================================================

# Database Settings
POSTGRES_DB=mobility
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Ingestion Source URLs
GTFS_URL=https://www2.anm.it/infoclick/infoclick.php?palina=3010
GTFS_FALLBACK_URL=https://www.anm.it/google/google-transit.zip
PBF_URL=https://download.geofabrik.de/europe/italy/sud-latest.osm.pbf

# Execution Flags
RUN_ON_STARTUP=true
AUTO_IMPORT_GTFS=true
SKIP_PBF_DOWNLOAD=false
