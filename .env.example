# ==============================================================================
# Environment Configuration for Postgres 18 + PostGIS + GTFS / OSM Ingestion
# ==============================================================================

# Database Settings
POSTGRES_DB=mobility
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Ingestion Source URLs
# Deve essere un archivio ZIP GTFS, non una pagina HTML.
GTFS_URL=https://www.anm.it/google/google-transit.zip
GTFS_FALLBACK_URL=
PBF_URL=https://download.geofabrik.de/europe/italy/sud-latest.osm.pbf

# GTFS autorevole (schema dedicato, fuori da public).
# GTFS_URL punta ad ANM: il download automatico aggiorna solo gtfs_anm.
# EAV resta in gtfs_eav e va importato dal file EAV validato.
GTFS_SCHEMA=gtfs_anm
GTFS_DATASET_KEY=anm
GTFS_OPERATOR_ID=ANM
GTFS_OPERATOR_NAME=Azienda Napoletana Mobilità
# Feed esposti contemporaneamente dal backend (key:schema,key:schema).
GTFS_DATASETS=eav:gtfs_eav,anm:gtfs_anm
# Dopo ogni import valido viene scritta una richiesta di rebuild OTP in
# /data/otp-rebuild; un servizio systemd dell'host la esegue.
OTP_REBUILD_ENABLED=true
OTP_REBUILD_REQUEST_DIR=/data/otp-rebuild
OSM_SCHEMA=osm_territory
OSM_DATASET_KEY=osm_napoli

# Backend
APP_PROFILE=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobility
OTP_BASE_URL=http://127.0.0.1:8080
OTP_TIMEOUT_S=30
ROUTING_MODE=real
ROUTING_TIMEZONE=Europe/Rome
JOURNEY_MAX_PLANS=3
JOURNEY_BUDGET_S=15
JOURNEY_DEFAULT_FIRST=10
LOG_LEVEL=info

# Agente Input / geocodifica locale
GEOCODER_PROVIDER=local
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_S=8
GEOCODER_MAX_RESULTS=5
INPUT_AGENT_LLM_REQUIRED=false

# Modello AI (OpenAI-compatible: DeepSeek, Ollama, vLLM, ...)
# Non riusare automaticamente credenziali di OpenCode: fornire una chiave
# dedicata al backend. LLM_MODE=live senza queste tre variabili resta un
# blocco esplicito, non una simulazione silenziosa.
LLM_MODE=off
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TEMPERATURE=0
LLM_PROMPT_VERSION=news-extraction-1
LLM_SCHEMA_VERSION=1
LLM_REPLAY_DIR=

# Worker di acquisizione (processo separato dall'API)
INGESTION_REGISTRY_PATH=
INGESTION_USER_AGENT=NapoliAgenticCity/1.0 (+backend ingestion worker)
INGESTION_TIMEOUT_S=20
INGESTION_MAX_CONCURRENCY=4
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF_S=2
INGESTION_POLL_INTERVAL_S=30
INGESTION_LEASE_S=300
INGESTION_UNKNOWN_EXPIRY_TTL_S=21600
INGESTION_REVIEW_TTL_S=7200
INGESTION_RELEVANCE_VERSION=1

# BusOne resta materiale legacy: non è richiesto dal percorso reale,
# dal worker, da `ingest --all` o dall'avvio predefinito.
